# ============================================================
# Niche Discovery Engine — System 1 configuration
# Copy to .env and adjust. Without .env the app runs in demo mode
# whenever LM Studio is unreachable.
# ============================================================

# --- LM Studio (local OpenAI-compatible server, running 24/7) ---
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Use the exact model identifiers shown in LM Studio's Developer tab.
PRIMARY_MODEL=Qwen 27B Flash
SMALL_MODEL=Qwen MoE 35B Flash
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
PRIMARY_MAX_INPUT_CHARS=24000
SMALL_MAX_INPUT_CHARS=16000

# --- Pipeline ---
ITEMS_PER_SOURCE=50
MAX_POSTS_TO_EXTRACT=250
QUERY_COUNT=20
SEED_KEYWORDS=data extraction,missing API,manual bottleneck,web scraping,spreadsheet automation,copy paste data,SaaS integration,no API
ENABLED_SOURCES=hacker_news,reddit,job_boards,yc_rfs,x,facebook
# DEMO_MODE=true   # force demo; false = force live; unset = auto-detect LM Studio

# --- Politeness (no proxies; be a good citizen) ---
REQUEST_DELAY_SECONDS=1.0
YC_DELAY_SECONDS=5.0
HTTP_TIMEOUT_SECONDS=25

# --- Advanced extraction engine: X / Twitter session cookies ---
# From browser DevTools > Application > Cookies on x.com (while logged in):
X_AUTH_TOKEN=
X_CT0=
# GraphQL query IDs rotate; copy fresh one from Network tab (SearchTimeline request):
X_GRAPHQL_QUERY_ID=

# --- Advanced extraction engine: Facebook session cookie ---
# Full cookie header from a logged-in facebook.com request (must include c_user and xs):
FACEBOOK_COOKIE=
FACEBOOK_DOC_ID=

# --- Storage / logging ---
# DATABASE_URL=sqlite:////absolute/path/to/custom.db
LOG_LEVEL=INFO